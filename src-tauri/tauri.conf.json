{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HVAC Duct Calculator",
  "version": "1.0.0",
  "identifier": "com.eakthai.hvacductcalculator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HVAC Duct Calculator",
        "width": 1100,
        "height": 760,
        "minWidth": 780,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
